<script>
  // 🔍 AUTO FILTER JUDUL - MOBILE FIX!
  document.getElementById("searchInput").addEventListener("keyup", function () {
    let filter = this.value.toLowerCase().trim();
    let cards = document.querySelectorAll("#bukuGrid .book-card");
    
    cards.forEach(function (card) {
      let titleElement = card.querySelector(".card-body h6.fw-bold");
      let title = titleElement ? titleElement.textContent.toLowerCase() : "";
      
      card.parentElement.style.display = title.includes(filter) ? "" : "none";
    });
  });

  // ✨ Typing Animation
  document.addEventListener("DOMContentLoaded", () => {
    const element = document.getElementById("typing");
    const cursor = document.getElementById("cursor");

    const text1 = "Selamat Datang di My Perpustakaan";
    const text2 = "Halo, {{ Auth::user()->name }}!";
    const text3 = "Silakan cari buku yang anda inginkan";

    const typingSpeed = 130;
    const eraseSpeed = 80;
    const delayBeforeErase = 1800;
    const delayBeforeNext = 700;

    let index = 0;

    setInterval(() => {
      cursor.style.opacity = cursor.style.opacity === "0" ? "1" : "0";
    }, 500);

    function typeText(text, callback) {
      if (index < text.length) {
        element.textContent += text.charAt(index);
        index++;
        setTimeout(() => typeText(text, callback), typingSpeed);
      } else {
        setTimeout(callback, delayBeforeErase);
      }
    }

    function eraseText(callback) {
      if (index > 0) {
        element.textContent = element.textContent.slice(0, -1);
        index--;
        setTimeout(() => eraseText(callback), eraseSpeed);
      } else {
        setTimeout(callback, delayBeforeNext);
      }
    }

    function startAnimation() {
      index = 0;
      element.textContent = "";

      typeText(text1, () => {
        eraseText(() => {
          index = 0;
          typeText(text2, () => {
            eraseText(() => {
              index = 0;
              typeText(text3, () => {});
            });
          });
        });
      });
    }

    startAnimation();
  });
</script>
