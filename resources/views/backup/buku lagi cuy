<script>
  // Filter pencarian buku
  document.getElementById("searchInput").addEventListener("keyup", function () {
    let filter = this.value.toLowerCase();
    let cards = document.querySelectorAll("#bukuGrid .card");
    cards.forEach(function (card) {
      let title = card.querySelector(".fw-bold").textContent.toLowerCase();
      card.parentElement.style.display = title.includes(filter) ? "" : "none";
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    const element = document.getElementById("typing");
    const cursor = document.getElementById("cursor");

    // 🟩 Teks yang ingin ditampilkan
    const text1 = "Selamat Datang di My Perpustakaan";
    const text2 = "Halo, {{ Auth::user()->name }}!";
    const text3 = "Silakan cari buku yang anda inginkan";

    // 🕒 Pengaturan kecepatan
    const typingSpeed = 130; // lebih lambat biar smooth
    const eraseSpeed = 80;
    const delayBeforeErase = 1800; // jeda sebelum hapus
    const delayBeforeNext = 700;   // jeda antar kalimat

    let index = 0;

    // ✨ Efek kursor berkedip
    setInterval(() => {
      cursor.style.opacity = cursor.style.opacity === "0" ? "1" : "0";
    }, 500);

    // ✍️ Fungsi ketik teks
    function typeText(text, callback) {
      if (index < text.length) {
        element.textContent += text.charAt(index);
        index++;
        setTimeout(() => typeText(text, callback), typingSpeed);
      } else {
        setTimeout(callback, delayBeforeErase);
      }
    }

    // ⌫ Fungsi hapus teks
    function eraseText(callback) {
      if (index > 0) {
        element.textContent = element.textContent.slice(0, -1);
        index--;
        setTimeout(() => eraseText(callback), eraseSpeed);
      } else {
        setTimeout(callback, delayBeforeNext);
      }
    }

    // 🔁 Urutan animasi
    function startAnimation() {
      index = 0;
      element.textContent = "";

      // 1️⃣ Ketik “Selamat Datang di My Perpustakaan”
      typeText(text1, () => {
        eraseText(() => {
          // 2️⃣ Ketik “Halo, [nama user]”
          index = 0;
          typeText(text2, () => {
            eraseText(() => {
              // 3️⃣ Ketik “Silakan cari buku...”
              index = 0;
              typeText(text3, () => {});
            });
          });
        });
      });
    }

    startAnimation();
  });
</script>
